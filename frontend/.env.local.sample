# ──────────────────────────────────────────────────────────
# DisasterAware Frontend — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit your .env.local file to version control.
# ──────────────────────────────────────────────────────────

# NextAuth.js
# Must match the deployed URL exactly.  Locally: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth  (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth  (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# IPinfo (location detection)  (https://ipinfo.io/account/token)
IPINFO_TOKEN=

# OpenWeatherMap  (https://openweathermap.org/api)
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# Backend API base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
